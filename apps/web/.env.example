# ─────────────────────────────────────────────────────────────
#  Aculion Email Server — Environment Variables TEMPLATE
#  Copy this file to ".env" and fill in your real values.
#  The ".env" file is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ── Resend API Key (REQUIRED) ────────────────────────────────
# Sign up at https://resend.com → Dashboard → API Keys → Create
# The key is server-side only — it is never exposed to React/Vite code.
RESEND_API_KEY=your_resend_api_key_here

# ── Contact destination ──────────────────────────────────────
# All inquiries submitted via the contact form are forwarded here.
CONTACT_EMAIL=connect@aculion.com
RECIPIENT_EMAIL=connect@aculion.com

# ── Optional: custom sender domain ──────────────────────────
# Only set this after verifying your domain in the Resend dashboard.
# Without it, emails are sent from onboarding@resend.dev (safe default).
# RESEND_FROM=Aculion Website <contact@aculion.com>

# ── General settings ─────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Supabase Authentication ──
VITE_SUPABASE_URL=https://buqtshfptmqieaqcghfx.supabase.co
