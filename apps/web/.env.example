# ─────────────────────────────────────────────────────────────
#  Aculion Frontend (apps/web) — Environment Variables Template
#  Copy this file to ".env" for local development.
#  The ".env" file is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ── Production Domain & Frontend URL ──
# Local development: http://localhost:5173
# Production (Vercel): https://www.aculion.com
VITE_APP_URL=https://www.aculion.com
FRONTEND_URL=https://www.aculion.com

# ── Backend API Gateway URL ──
# Local development: http://localhost:8080
# Production (Vercel): https://<railway-api-gateway-domain>
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# ── Supabase Authentication (Browser-Safe Public Credentials) ──
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Optional Map / Visual Analytics Keys ──
VITE_CARTO_API_KEY=your_carto_api_key_here

# ── Server-Side Email Credentials (Used by local server.js and Vercel /api/contact) ──
# Server-side only — never exposed to the browser
RESEND_API_KEY=re_your_resend_api_key_here
RECIPIENT_EMAIL=connect@aculion.com
CONTACT_EMAIL=connect@aculion.com
# RESEND_FROM=Aculion Website <onboarding@resend.dev>

# ── Local Development Port (for Express server.js) ──
PORT=3001
