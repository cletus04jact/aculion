# ─────────────────────────────────────────────────────────────
#  ACULION PLATFORM — Unified Backend Environment Variables Template
#  Copy this file to ".env" for local development.
# ─────────────────────────────────────────────────────────────

# Server Port (Railway automatically injects $PORT; local default is 8080)
PORT=8080

# PostgreSQL / PostGIS Database Connection URL
# On Railway: Injected automatically by the Railway PostgreSQL plugin
# Local: postgresql://postgres:NewPassword123@localhost:5432/location_intelligence
DATABASE_URL=postgresql://postgres:NewPassword123@localhost:5432/location_intelligence

# Fallback Database connection parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=location_intelligence
DB_USER=postgres
DB_PASSWORD=NewPassword123

# Supabase Credentials (Used by admin user provisioning and realtime telemetry)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Allowed CORS Origins
# Production: https://www.aculion.com,https://aculion.com
# Local: http://localhost:5173,http://localhost:5176
FRONTEND_URL=https://www.aculion.com
ALLOWED_ORIGINS=https://www.aculion.com,https://aculion.com,http://localhost:5173,http://localhost:5176
