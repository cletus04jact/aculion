# Aculion API Gateway — Environment Variables Configuration
# Copy this file to ".env" for local development settings.

# Port to listen on (default for API Gateway is 8080)
PORT=8080

# Downstream services routing URLs
LOCATION_SERVICE_URL=http://localhost:8000
TRAFFIC_SERVICE_URL=http://localhost:8095

# Allowed CORS origins (comma-separated list, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176
