# ─────────────────────────────────────────────────────────────
#  Aculion API Gateway — Environment Variables Template
#  Copy this file to ".env" for local development.
# ─────────────────────────────────────────────────────────────

# Port to listen on (Railway supplies PORT automatically in production; local default is 8080)
PORT=8080

# Downstream services routing URLs
# Local development:
LOCATION_SERVICE_URL=http://localhost:8000
TRAFFIC_SERVICE_URL=http://localhost:8095

# Production (Railway Private Networking example):
# LOCATION_SERVICE_URL=http://location-service.railway.internal:8000
# TRAFFIC_SERVICE_URL=http://traffic-service.railway.internal:8095
# Or using Railway public URLs:
# LOCATION_SERVICE_URL=https://<location-service-name>.up.railway.app
# TRAFFIC_SERVICE_URL=https://<traffic-service-name>.up.railway.app

# Allowed CORS origins
# Production: https://www.aculion.com,https://aculion.com
# Local: http://localhost:5173,http://localhost:5176
FRONTEND_URL=https://www.aculion.com
ALLOWED_ORIGINS=https://www.aculion.com,https://aculion.com,http://localhost:5173,http://localhost:5176
