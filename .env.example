# ─────────────────────────────────────────────────────────────
#  ACULION PLATFORM — Root Monorepo Environment Variables Reference
#  This file provides a consolidated overview of environment variables
#  required for Vercel (Frontend) and Railway (Backend Services).
# ─────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════
# 1. FRONTEND (Vercel — Root Directory: apps/web)
# ═════════════════════════════════════════════════════════════
# Production Frontend Origin
VITE_APP_URL=https://www.aculion.com
FRONTEND_URL=https://www.aculion.com

# Railway API Gateway Domain (Set after deploying API Gateway on Railway)
VITE_API_URL=https://<railway-api-gateway-domain>
VITE_API_BASE_URL=https://<railway-api-gateway-domain>

# Supabase Authentication (Browser-safe anon key)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional Carto API Key for Map Tiles
VITE_CARTO_API_KEY=your_carto_api_key_here

# Resend Email API Key (Server-side for Vercel /api/contact function)
RESEND_API_KEY=re_your_resend_api_key_here
RECIPIENT_EMAIL=connect@aculion.com

# ═════════════════════════════════════════════════════════════
# 2. API GATEWAY (Railway — Root Directory: services/api-gateway)
# ═════════════════════════════════════════════════════════════
# PORT is assigned automatically by Railway ($PORT)
PORT=8080

# Downstream Microservices URLs (Using Railway Private Networking or Public URLs)
LOCATION_SERVICE_URL=http://location-service.railway.internal:8000
TRAFFIC_SERVICE_URL=http://traffic-service.railway.internal:8095

# CORS Allowed Origins
FRONTEND_URL=https://www.aculion.com
ALLOWED_ORIGINS=https://www.aculion.com,https://aculion.com,http://localhost:5173,http://localhost:5176

# ═════════════════════════════════════════════════════════════
# 3. LOCATION SERVICE (Railway — Root Directory: services/location-service)
# ═════════════════════════════════════════════════════════════
PORT=8000

# PostgreSQL / PostGIS Database Connection URL (From Railway Postgres plugin)
DATABASE_URL=postgresql://postgres:password@host:port/database

# Supabase Admin Sync
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

FRONTEND_URL=https://www.aculion.com
ALLOWED_ORIGINS=https://www.aculion.com,https://aculion.com,http://localhost:5173,http://localhost:5176

# ═════════════════════════════════════════════════════════════
# 4. TRAFFIC SERVICE (Railway — Root Directory: services/traffic-service)
# ═════════════════════════════════════════════════════════════
PORT=8095

# Supabase Client
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

FRONTEND_URL=https://www.aculion.com
ALLOWED_ORIGINS=https://www.aculion.com,https://aculion.com,http://localhost:5173,http://localhost:5176
